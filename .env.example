# 复制成 .env 再填。.env 已被 .gitignore 忽略，不会进版本库。
#
# 启动器会自动读写这个文件：你在窗口里填的 Base URL / 模型 / API Key
# 会存在这里，下次启动直接带出来，不用重填。

# 内存条后端：local | openai-compat | anthropic
DDR_AI_BACKEND=openai-compat

# OpenAI 兼容端点（OpenAI / DeepSeek / 本地 vLLM / Ollama…）
DDR_AI_BASE_URL=https://api.openai.com/v1
DDR_AI_MODEL=gpt-4o-mini
DDR_AI_API_KEY=

# Anthropic 用这个地址：
# DDR_AI_BASE_URL=https://api.anthropic.com/v1
# DDR_AI_MODEL=claude-3-5-haiku-latest

# 采样温度
DDR_AI_TEMPERATURE=0.0

# 输出上限。思考型模型（deepseek-flash / deepseek-reasoner 等）
# 的思考过程也吃这个预算，给太小会导致回复为空——别调太小。
# 建议 512 以上；调太小会触发自动升档重试，延迟翻倍。
DDR_AI_MAX_TOKENS=512

# 给真模型多少内存上下文：state / recent / none
#
#   state  —— 每次请求附带内存当前内容的十六进制转储（默认，读得对）
#   recent —— 只附最近几次收发记录，省 token
#   none   —— 什么都不给
#
# 注意：语言模型是**无状态**的，每次请求都是独立调用。
# 选 none，它读内存时就只能瞎猜——READ 必然全错，你会看到
# "读错了：它说 00，实际记的是 48" 刷屏。这不是模型的错。
DDR_AI_CONTEXT_MODE=state

# ---------------------------------------------------------------
# 思考控制
# ---------------------------------------------------------------
# 关键认知：**关掉思考 ≠ 模型就不思考了**。
# deepseek-flash 这类模型关不掉思考，你不发任何思考参数，它照样想、
# 照样吃 max_tokens——表现就是"跑着跑着力不从心"。
#
# 下面每一项都配一个开关：只有开关为 1，对应字段才会进请求 JSON。
# 各家模型的字段名和支持情况都不一样，所以不硬编码。

# 思考总开关
DDR_AI_THINKING=1

# 关闭思考时发什么 JSON。留空 = 请求里完全不出现思考字段。
# 有的端点支持显式关闭，可填 {"thinking": {"type": "disabled"}}
DDR_AI_THINKING_OFF_JSON=

# 思考强度（字段 reasoning_effort）。OpenAI 系吃 low/medium/high，
# 兼容端点可能吃 minimal/xhigh 或别的名字，可以手改。
DDR_AI_THINKING_EFFORT_ENABLED=0
DDR_AI_THINKING_EFFORT=medium

# 思考预算（token 数）。Anthropic 会自动包成 thinking.budget_tokens。
DDR_AI_THINKING_TOKENS_ENABLED=0
DDR_AI_THINKING_BUDGET_TOKENS=2048

# 自定义思考参数，原样合并进请求体，用来适配各家不同字段名。
DDR_AI_THINKING_PARAM_ENABLED=0
DDR_AI_THINKING_PARAM_JSON={"thinking": {"type": "enabled"}}

# 自定义请求 JSON，会深合并进请求体。优先级最高，能覆盖上面任何一项。
# DDR_AI_EXTRA_JSON={"top_p": 0.9}
